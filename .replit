run = "corepack enable && corepack prepare pnpm@10.4.1 --activate && pnpm install && bash scripts/replit-start.sh"
modules = ["nodejs-20"]

[nix]
channel = "stable-24_05"

[env]
NODE_ENV = "development"

[[ports]]
localPort = 3000
externalPort = 80

[deployment]
run = ["sh", "-c", "corepack enable && corepack prepare pnpm@10.4.1 --activate && pnpm install && NODE_ENV=production bash scripts/replit-start.sh"]
deploymentTarget = "cloudrun"
