run = "corepack enable && corepack prepare pnpm@10.4.1 --activate && pnpm install && pnpm dev"
modules = ["nodejs-20"]

[nix]
channel = "stable-24_05"

[env]
NODE_ENV = "development"

[[ports]]
localPort = 3000
externalPort = 80

[deployment]
run = ["sh", "-c", "corepack enable && corepack prepare pnpm@10.4.1 --activate && pnpm install && pnpm build && pnpm start"]
deploymentTarget = "cloudrun"
