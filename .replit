run = "npm install && bash scripts/replit-start.sh"
modules = ["nodejs-20"]

[nix]
channel = "stable-24_05"
packages = ["mariadb", "nodejs_20", "libaio"]

[env]
NODE_ENV = "development"

[[ports]]
localPort = 3000
externalPort = 80

[deployment]
run = ["sh", "-c", "npm install && NODE_ENV=production bash scripts/replit-start.sh"]
deploymentTarget = "cloudrun"
