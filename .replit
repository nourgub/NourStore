run = "npm install && bash scripts/replit-start.sh"
modules = ["nodejs-22"]

[nix]
channel = "stable-24_05"
packages = ["mariadb", "nodejs_22", "libaio"]

[env]
NODE_ENV = "development"
# The female teacher speaks with the owner's voice pack (uploads/tts-cache,
# docs/VOICE_PACK_INSTALL.md). Unused when the pack is not there.
TAFAWOQ_VOICE_PACK_FEMALE = "dz-teacher-f"
# Uncomment for the owner's voice only (text without voice where the pack lacks a sentence):
# TAFAWOQ_VOICE_EXCLUSIVE = "female"

[[ports]]
localPort = 3000
externalPort = 80

[deployment]
run = ["sh", "-c", "npm install && NODE_ENV=production bash scripts/replit-start.sh"]
deploymentTarget = "cloudrun"
