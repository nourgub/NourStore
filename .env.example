# Copy this file to .env and fill in real values, then run:
#   docker compose up -d      (migrations run automatically on start)
#
# Never commit .env. On Replit/Railway, put these values in the host's
# Secrets panel instead. The "change_me" values below are refused by the
# server in production (NODE_ENV=production) — replace every one of them.
#
# Everything below is plain configuration — no external account or signup
# required for any of it except AUTH_PROVIDER=google (a one-time, free
# Google Cloud Console credential — see DEPLOYMENT.md), and even that's
# optional if you'd rather use the built-in email+password login instead.

# --- MySQL (self-hosted via docker-compose.yml, zero external service) ---
# MySQL creates this database and user only the first time its volume is
# initialised: a deployment created before the rename to Tafawoq must keep
# the names its .env already has (nourix_academy / nourix, see
# docs/LEGACY.md).
MYSQL_ROOT_PASSWORD=change_me_to_a_real_random_password
MYSQL_DATABASE=tafawoq
MYSQL_USER=tafawoq
MYSQL_PASSWORD=change_me_to_a_real_random_password
# Published on 127.0.0.1 only (this machine), never to the network.
MYSQL_PORT=3306

# --- Database address for the app ---
# docker-compose builds DATABASE_URL from the MYSQL_* values above. Where
# DATABASE_URL already belongs to another service (Replit's managed
# PostgreSQL, for instance), set TAFAWOQ_DATABASE_URL instead: it wins, and
# anything other than mysql:// is refused at start-up and by migrations.
# TAFAWOQ_DATABASE_URL=mysql://USER:PASSWORD@127.0.0.1:3306/tafawoq

# --- App ---
APP_PORT=3000
JWT_SECRET=change_me_generate_with_openssl_rand_hex_32
# The site's public address, used in links sent by email (password reset).
# REQUIRED in production — never taken from the request's Host header there.
APP_BASE_URL=https://tafawoq.example.com
# Other sites allowed to send requests with the session (comma-separated
# origins). Requests from any other site are refused (cross-site protection).
TAFAWOQ_ALLOWED_ORIGINS=

# --- Email (password reset links) ---
# Any SMTP provider (Brevo, Mailjet, Gmail SMTP, your host…). Empty = no email
# is sent: in development the link is printed to the server console; in
# production a warning is logged and the student asks an admin to reset the
# password (admin panel → Accounts). Store the URL in the host's secrets.
#   smtps://USER:PASSWORD@smtp.example.com:465   (TLS)
#   smtp://USER:PASSWORD@smtp.example.com:587    (STARTTLS)
SMTP_URL=
MAIL_FROM=Tafawoq <no-reply@tafawoq.example.com>

# --- Live sessions with a teacher ---
# Video room base URL (https only). Default https://meet.jit.si — on the public
# Jitsi server the first person to join may be asked to sign in to become
# moderator; a self-hosted Jitsi avoids that.
TAFAWOQ_MEETING_BASE_URL=

# --- First admin bootstrap (optional but recommended) ---
# Whichever account's openId matches this exactly is granted "admin" on its
# next sign-in — for email/password accounts that's "email_<lowercased
# address>" (e.g. OWNER_OPEN_ID=email_owner@example.com), for Google OAuth
# it's "google_<the Google account's sub>". Every other admin promotion
# after that goes through an existing admin, from the admin panel — nobody
# can grant themselves admin. Leave empty and grant the first admin
# directly in the database instead.
OWNER_OPEN_ID=

# --- Managed MySQL over TLS (only needed against a provider like Aiven/
# PlanetScale whose connection string has a `ssl-mode=REQUIRED` query
# param — irrelevant for the self-hosted docker-compose.yml MySQL above).
# The provider's own dashboard gives you this CA certificate, PEM-encoded;
# it's not a secret. Without it set, TLS verification against such a
# provider fails with "self-signed certificate in certificate chain".
DATABASE_CA_CERT=

# --- Redis (optional — only needed for correct rate limiting across
# multiple app instances; a single-instance deployment works fine without
# it). docker-compose.yml builds REDIS_URL for the app container from
# REDIS_PASSWORD; set REDIS_URL yourself only when running outside
# docker-compose (e.g. redis://:password@host:6379).
REDIS_PASSWORD=change_me_to_a_real_random_password
REDIS_URL=

# --- Auth: choose ONE for the main "sign in" button, or ignore both and
# just use the built-in email+password forms at /login and /register,
# which work regardless of this setting and need no external provider.
# "email": email+password only (no external service). "google": also show
# "Sign in with Google" — then set both values below (see DEPLOYMENT.md).
AUTH_PROVIDER=email
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- File storage: "local" (zero external service, this machine's disk) ---
STORAGE_PROVIDER=local
# Switch to "s3" for any S3-compatible object storage (real AWS S3, or
# R2/B2/MinIO via S3_ENDPOINT) — leave all of these empty while local.
S3_BUCKET=
S3_REGION=auto
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_BASE_URL=

# --- Host-side port of the self-hosted `redis` service (127.0.0.1 only) ---
REDIS_PORT=6379

# --- Analytics (optional, self-hosted — no third-party account required).
# Both must be set for the analytics script to load at all; leaving either
# empty means no script is injected and no request is made, by design.
# Run Umami yourself (umami.is is open-source and self-hostable), then:
#   VITE_ANALYTICS_ENDPOINT=https://your-umami-instance.example.com
#   VITE_ANALYTICS_WEBSITE_ID=the-website-id-umami-gives-you
# These are VITE_-prefixed because they're read at build time on the
# client (see client/src/main.tsx), not the server — like every Vite env
# var, they end up visible in the built JS bundle, so never put a secret
# here, only a public endpoint URL and a website id.
VITE_ANALYTICS_ENDPOINT=
VITE_ANALYTICS_WEBSITE_ID=

# --- AI teacher — the personal teacher at /tafawoq. Works fully
# for free with these left EMPTY (generated exercises, equivalence grading,
# rule-based tutor — no AI service is ever called). Optionally, a Claude API
# key (https://console.anthropic.com) adds model-written lessons, exercises,
# tutor replies and video scripts on top. TAFAWOQ_MODEL overrides the
# default model set in server/tafawoq/ai.ts.
ANTHROPIC_API_KEY=
# Ceiling on AI calls per day for the whole platform (cost guard); once
# reached the teacher falls back to the free rule-based replies until
# midnight UTC. Default 500.
TAFAWOQ_AI_DAILY_CALLS=
# Tafawoq: the official BAC date once announced (YYYY-MM-DD) for the countdown;
# unset = estimated as the second Sunday of June.
TAFAWOQ_BAC_DATE=
# Tafawoq teacher's natural voice (server/tafawoq/tts.ts). Free by default:
# Piper (open source, runs on this server) — scripts/fetch-piper.mjs installs
# it into TAFAWOQ_PIPER_DIR (replit-start.sh and the Docker image do this
# automatically; docker-compose.yml defaults it to /app/uploads/piper).
TAFAWOQ_PIPER_DIR=
# Optional, more natural: Google Cloud Text-to-Speech (WaveNet). Create an
# API key restricted to the Text-to-Speech API; put it in your secrets.
GOOGLE_TTS_API_KEY=
# Monthly cap on characters sent to Google (default 3500000, inside the
# 4 M/month free quota); beyond it the free Piper voice is used.
TAFAWOQ_TTS_MONTHLY_CHARS=
# Google voices: male (default ar-XA-Wavenet-B) and female (default ar-XA-Wavenet-A).
TAFAWOQ_TTS_VOICE=
TAFAWOQ_TTS_VOICE_FEMALE=
# A prepared voice pack (voice-dataset/pack/README.md): everything the
# teacher says, recorded once with an open model (Chatterbox, MIT) on a free
# GPU from a consenting speaker's short sample, then imported. Tried first;
# free and unlimited. The value names the pack used at export/import.
TAFAWOQ_VOICE_PACK_MALE=
TAFAWOQ_VOICE_PACK_FEMALE=
# Sample rate of the pack's recordings (default 24000).
TAFAWOQ_VOICE_PACK_RATE=
# Optional, closest to an Algerian teacher: Microsoft Azure Speech, tried
# first. Create a free (F0) Speech resource; put its key and region (e.g.
# westeurope) in your secrets. Default voices are Algerian: ar-DZ-IsmaelNeural
# (male) and ar-DZ-AminaNeural (female); e.g. ar-AE-FatimaNeural also works.
# Algerian Dardja voice from our own TassiliTTS service (services/tassili-tts):
# optional, used first for Arabic when set and when the service reports a
# consented reference voice. Read services/tassili-tts/README.md (licence!).
# One teacher voice only (female | male): only the voice pack / TassiliTTS
# voice of that teacher speaks; anything it lacks is shown as text, never
# said by another voice. Empty = normal fallbacks.
TAFAWOQ_VOICE_EXCLUSIVE=
# Where prepared voice recordings (and the voice pack) are kept; default uploads/tts-cache.
TAFAWOQ_TTS_CACHE_DIR=
TAFAWOQ_TASSILI_URL=
TAFAWOQ_TASSILI_TOKEN=
# TAFAWOQ_TASSILI_TIMEOUT_MS=90000
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=
TAFAWOQ_AZURE_VOICE_MALE=
TAFAWOQ_AZURE_VOICE_FEMALE=
# Monthly cap on characters sent to Azure (default 450000, inside the F0
# tier's 500 k/month); beyond it Google or Piper take over.
TAFAWOQ_AZURE_MONTHLY_CHARS=
# A female Piper model (.onnx with its .json next to it), when you have one.
PIPER_MODEL_FEMALE=
# The paid voices' fixed sentences are prepared in the background with the
# month's spare allowance (cached for good); 0 turns that off.
TAFAWOQ_TTS_WARMUP=
# Hourly in-app reminders (subscription ending/ended, confirmed sessions in the
# next 24 h, weekly test from Thursday). Safe with several instances (one copy
# per reminder). 0 turns them off. No email is sent by the reminders.
TAFAWOQ_REMINDERS=
# How many variants of each generated exercise the teacher says aloud (call,
# oral quiz, worked examples; default 30). Fewer = voiced sooner, less
# variety. Written practice and exams keep unlimited variety.
TAFAWOQ_SPOKEN_VARIANTS=
# On a hosted deployment whose disk is wiped on every deploy (Replit
# Deployments), set STORAGE_PROVIDER=s3 (e.g. Cloudflare R2, free up to
# 10 GB): the recorded voice is kept there too and never paid for twice.
TAFAWOQ_MODEL=
