DATABASE_URL="file:./prisma/dev.db"

# Admin panel credentials
ADMIN_USERNAME="admin"
ADMIN_PASSWORD="change-me"

# Secret used to sign the admin session cookie (any long random string)
SESSION_SECRET="change-me-to-a-long-random-string"

# Payment details shown to customers on the order confirmation page
PAYMENT_BARIDIMOB_NAME=""
PAYMENT_BARIDIMOB_PHONE=""
PAYMENT_CCP_NUMBER=""
PAYMENT_BANK_RIB=""
SUPPORT_WHATSAPP=""

# Legal/business name shown on generated PDF invoices (defaults to "نور ستور")
STORE_LEGAL_NAME=""

# PDF invoices are rendered with a headless Chromium browser (via playwright-core).
# Leave empty to use playwright-core's default browser resolution — requires running
# `npx playwright install chromium` once on the server, or set PLAYWRIGHT_BROWSERS_PATH
# to a directory with a Chromium build already installed. Set this only if Chromium
# lives at a specific, non-default path on your server.
CHROMIUM_EXECUTABLE_PATH=""

# WhatsApp Cloud API (Meta) — leave empty to disable real sending (messages are
# still logged/recorded, just not delivered). See README for setup steps.
WHATSAPP_ACCESS_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_VERIFY_TOKEN=""
