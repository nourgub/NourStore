# Copy this file to .env and fill in real values, then run:
#   docker compose up -d
#   node scripts/migrate.mjs
#
# Everything below is plain configuration — no external account or signup
# required for any of it except AUTH_PROVIDER=google (a one-time, free
# Google Cloud Console credential — see DEPLOYMENT.md), and even that's
# optional if you'd rather use the built-in email+password login instead.

# --- MySQL (self-hosted via docker-compose.yml, zero external service) ---
MYSQL_ROOT_PASSWORD=change_me_to_a_real_random_password
MYSQL_DATABASE=nourix_academy
MYSQL_USER=nourix
MYSQL_PASSWORD=change_me_to_a_real_random_password
MYSQL_PORT=3306

# --- App ---
APP_PORT=3000
JWT_SECRET=change_me_generate_with_openssl_rand_hex_32

# --- First admin bootstrap (optional but recommended) ---
# Whichever account's openId matches this exactly is granted "admin" on its
# next sign-in — for email/password accounts that's "email_<lowercased
# address>" (e.g. OWNER_OPEN_ID=email_owner@example.com), for Google OAuth
# it's "google_<the Google account's sub>". Every other admin promotion
# after that goes through an existing admin, from the admin panel — nobody
# can grant themselves admin. Leave empty and grant the first admin
# directly in the database instead.
OWNER_OPEN_ID=

# --- Managed MySQL over TLS (only needed against a provider like Aiven/
# PlanetScale whose connection string has a `ssl-mode=REQUIRED` query
# param — irrelevant for the self-hosted docker-compose.yml MySQL above).
# The provider's own dashboard gives you this CA certificate, PEM-encoded;
# it's not a secret. Without it set, TLS verification against such a
# provider fails with "self-signed certificate in certificate chain".
DATABASE_CA_CERT=

# --- Redis (optional — only needed for correct rate limiting across
# multiple app instances; a single-instance deployment works fine without
# it). This is the actual variable the app reads — docker-compose.yml's
# `redis` service sets it to redis://redis:6379 automatically for the app
# container; set it yourself here only if running outside docker-compose.
REDIS_URL=

# --- Payments: this platform only ever takes payment manually (postal/CCP
# bank transfer + a receipt upload or WhatsApp, reviewed by an admin — see
# DEPLOYMENT.md). No automated gateway is wired up, so none of these
# credentials are needed at all. PAYMENT_PROVIDER/PAYMENT_WEBHOOK_SECRET
# only exist for a future automated gateway's webhook contract
# (server/paymentsWebhook.ts) — leave both unset.
PAYMENT_PROVIDER=
PAYMENT_WEBHOOK_SECRET=

# --- WhatsApp Cloud API (Meta) — optional, powers the WhatsApp payment
# bot (server/whatsappBot.ts). Needs a real Meta Business / WhatsApp
# Business Platform setup: a verified phone number, a permanent access
# token, and a webhook verify token you choose yourself.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=

# --- Auth: choose ONE for the main "sign in" button, or ignore both and
# just use the built-in email+password forms at /login and /register,
# which work regardless of this setting and need no external provider.
# Option A: Google OAuth (see DEPLOYMENT.md for how to get these two values)
AUTH_PROVIDER=google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Option B: leave AUTH_PROVIDER unset — it defaults to "google" anyway.

# --- File storage: "local" (zero external service, this machine's disk) ---
STORAGE_PROVIDER=local
# Switch to "s3" for any S3-compatible object storage (real AWS S3, or
# R2/B2/MinIO via S3_ENDPOINT) — leave all of these empty while local.
S3_BUCKET=
S3_REGION=auto
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_BASE_URL=

# --- Redis port for the self-hosted `redis` service in docker-compose.yml
# (the host-side port only; the app itself talks to Redis via REDIS_URL
# above, already wired to the right internal address by docker-compose) ---
REDIS_PORT=6379

# --- Scheduled jobs / cron (optional — required only for the periodic
# subscription-expiry and stale-payment-receipt notification sweeps to run
# automatically; the app works fine without this, an admin can also trigger
# both sweeps manually from the dashboard). Set this to a real random value
# and the self-hosted `cron` service in docker-compose.yml will start
# calling /api/scheduled/* hourly with it.
CRON_SECRET=

# --- Analytics (optional, self-hosted — no third-party account required).
# Both must be set for the analytics script to load at all; leaving either
# empty means no script is injected and no request is made, by design.
# Run Umami yourself (umami.is is open-source and self-hostable), then:
#   VITE_ANALYTICS_ENDPOINT=https://your-umami-instance.example.com
#   VITE_ANALYTICS_WEBSITE_ID=the-website-id-umami-gives-you
# These are VITE_-prefixed because they're read at build time on the
# client (see client/src/main.tsx), not the server — like every Vite env
# var, they end up visible in the built JS bundle, so never put a secret
# here, only a public endpoint URL and a website id.
VITE_ANALYTICS_ENDPOINT=
VITE_ANALYTICS_WEBSITE_ID=
