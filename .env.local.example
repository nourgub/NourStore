# انسخ هذا الملف إلى .env.local وضع مفتاحك فيه لتفعيل التوليد الحقيقي بالذكاء الاصطناعي.
# بدون هذا المفتاح، تعمل المنصة تلقائيًا ببنك أسئلة تجريبي (mock) دون أي خطأ،
# ولا يعمل تصحيح أوراق التلاميذ إطلاقًا (لا بديل تجريبي لقراءة خط اليد).
# احصل على المفتاح من: https://console.anthropic.com
ANTHROPIC_API_KEY=

# اختياري — يغيّر نموذج Claude المستعمل في كل الميزات (توليد الامتحانات،
# تحضير الدرس، التصحيح، مساعد الأستاذ). اتركه فارغًا لاستعمال الافتراضي
# الموثّق في الكود (claude-sonnet-5) وهو خيار متوازن بين الجودة والتكلفة.
ANTHROPIC_MODEL=

# اختياري — يفعّل المراجعة المستقلة عبر Gemini (مراجعة الامتحانات وتصحيح
# أوراق التلاميذ بشكل مستقل عن Claude، للمقارنة بين النموذجين). بدون هذا
# المفتاح تظهر حالة "لم تتم المراجعة" بوضوح في كل مكان، ولا تتعطل أي ميزة
# أخرى. احصل على المفتاح من: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# اختياري — نموذج Gemini المستعمل للمراجعة المستقلة. الافتراضي
# gemini-flash-latest (اسم مستعار رسمي من Google يتحدّث تلقائيًا ليشير دائمًا
# لأحدث نموذج Flash — اقتصادي ومناسب لدور "مراجع مستقل" وليس التوليد
# الأساسي). تم التحقق من صحة هذا الاسم مباشرة من توثيق Google بتاريخ
# 2026-10-24 (لا يزال مذكورًا كمثال حي لنمط "latest" في صفحة النماذج). إن
# أردت تثبيت نموذج مُحدَّد بدل الاسم المتحرك (حتى لا يتغيّر سلوكه دون علمك)
# استعمل مثلاً gemini-3.5-flash-lite (الأسرع والأرخص حاليًا). راجع دائمًا
# https://ai.google.dev/gemini-api/docs/models قبل الاستخدام التجاري، لأن
# توليفة النماذج المتاحة تتغيّر من Google باستمرار.
GEMINI_MODEL=

# بريدك الإلكتروني الذي ستسجّل به حساب الإدارة. يمنحك صلاحية الوصول إلى
# /admin فقط إذا سجّلت بهذا البريد **مع** تمرير ADMIN_BOOTSTRAP_TOKEN أدناه
# في نفس طلب التسجيل — مجرد مطابقة البريد وحدها لم تعد كافية (كانت ثغرة:
# أي شخص يعرف بريدك الإداري يمكنه سبقك للتسجيل به والاستحواذ على صلاحيات
# الإدارة بلا طريقة لاستعادتها). بدون ADMIN_BOOTSTRAP_TOKEN مضبوطًا، لا يمكن
# منح صلاحية الإدارة عبر التسجيل إطلاقًا.
ADMIN_EMAIL=

# سرّ عشوائي طويل (مثال: شغّل `openssl rand -hex 32` لتوليد واحد) يجب
# تمريره كحقل "adminToken" في طلب التسجيل بالضبط مرة واحدة، مع بريد يطابق
# ADMIN_EMAIL أعلاه، لتفعيل حساب الإدارة. لا تضعه في أي نموذج تسجيل عام —
# استعمله فقط من طرفية أو أداة مثل Postman عند إنشاء حسابك الإداري أول مرة،
# ثم يمكنك حذفه من البيئة بعدها إن أردت (صلاحية الإدارة تبقى محفوظة في
# قاعدة البيانات ولا تعتمد على بقاء هذا المتغيّر).
ADMIN_BOOTSTRAP_TOKEN=

# اختياري — إعداد SMTP لتفعيل استعادة كلمة المرور الذاتية عبر بريد إلكتروني
# حقيقي (رابط صالح لمدة ساعة، يغيّر المعلّم كلمة مروره بنفسه فورًا). بدون
# هذه القيم تعمل المنصة بالوضع الافتراضي الحالي: الطلب يصل إلى لوحة الأدمن
# ليُعاد تعيين كلمة المرور يدويًا — لا تتعطل أي ميزة. يعمل مع أي مزوّد SMTP
# عادي (مثال: Gmail عبر "App Password"، أو SendGrid/Mailgun عبر SMTP، أو
# خادم بريد المدرسة الخاص).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# اختياري — عنوان "المرسل" الظاهر للمعلّم؛ افتراضيًا نفس SMTP_USER.
SMTP_FROM=

# اختياري — الرابط الأساسي العام للمنصة (بدون شرطة مائلة في النهاية)،
# يُستعمل فقط لبناء رابط إعادة تعيين كلمة المرور داخل البريد الإلكتروني.
# إن تُرك فارغًا تُستنتج القيمة تلقائيًا من رابط الطلب نفسه، وهذا يكفي في
# أغلب الحالات؛ اضبطه صراحة إن كانت المنصة خلف وسيط (proxy) يُغيّر الرابط
# الظاهر. مثال: https://nourstore.fly.dev
APP_BASE_URL=

# معلومات الدفع المعروضة للأستاذ في صفحة /billing — بدون هذه القيم تظهر
# قيم تجريبية وهمية (placeholder) بدل قيم حقيقية، والمنصة تعمل بدونها.
BILLING_PRICE_LABEL="1000 دج / شهريًا"
BILLING_ACCOUNT_NAME=
BILLING_ACCOUNT_RIP=
# رقم واتساب لاستقبال إشعار فوري (بصيغة دولية بدون +، مثال: 213500000000)
BILLING_WHATSAPP_NUMBER=
