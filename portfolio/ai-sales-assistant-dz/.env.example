# Copy to .env and fill in. Never commit .env.

# --- Store -------------------------------------------------------------------------
STORE_NAME=متجري الذكي
DB_PATH=data/store.db
# Add the demo catalogue to an empty database (set false once real products are loaded)
SEED_DEMO_DATA=true

# --- AI (Anthropic) ----------------------------------------------------------------
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5
ANTHROPIC_EFFORT=low
MAX_AGENT_STEPS=6

# --- Staff login -------------------------------------------------------------------
# Create the first admin with:  flask --app app create-user --username you --role admin
SESSION_HOURS=8
# Keep true in production (HTTPS). Set false only for local http://127.0.0.1 testing.
SESSION_COOKIE_SECURE=true
# Demo/migration only: accept the shared ADMIN_TOKEN header as an admin login. NOT for production.
DEMO_MODE=false
ADMIN_TOKEN=

# --- Abuse protection --------------------------------------------------------------
# Shared counters for several workers/containers, e.g. redis://redis:6379/0 (empty = per process)
REDIS_URL=
CHAT_LIMIT_PER_10_MIN=30
CONFIRM_LIMIT_PER_10_MIN=10
STATUS_LIMIT_PER_10_MIN=20
LOGIN_LIMIT_PER_15_MIN=5
ADMIN_LIMIT_PER_MIN=120
# Public demo: max assistant replies per day for all visitors together (0 = no limit)
DAILY_CHAT_LIMIT=0
MAX_REQUEST_BYTES=32768
MAX_QUANTITY_PER_LINE=20
# Number of reverse proxies in front of the app whose X-Forwarded-For can be trusted (0 = none)
TRUSTED_PROXY_COUNT=0

# --- Browser security --------------------------------------------------------------
# Only when the site is served over HTTPS
ENABLE_HSTS=false
# Other sites allowed to call the public API, comma-separated (empty = none)
CORS_ORIGINS=

# --- Privacy / retention -----------------------------------------------------------
# Name and phone of delivered/cancelled orders are erased after this many days (0 = never)
ORDER_RETENTION_DAYS=365
# Unconfirmed order summaries are deleted after this many hours
PROPOSAL_RETENTION_HOURS=24

# --- Operations --------------------------------------------------------------------
LOG_LEVEL=INFO
# /metrics is disabled while this is empty
METRICS_TOKEN=
BACKUP_DIR=backups
HOST=127.0.0.1
PORT=5000
# Gunicorn workers in Docker; keep 1 unless REDIS_URL is set
WEB_CONCURRENCY=1
