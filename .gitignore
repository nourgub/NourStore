# Secrets — never commit real environment values
.env
.env.local
.env.*.local
# Hosting-platform project files carry real secrets (a database URL, keys)
.project-config.json

# Dependencies
node_modules/

# Build output
dist/
build/

# Test/coverage artifacts
coverage/

# Editor/OS noise
.DS_Store
*.log

# Local uploads/storage (local storage provider writes here)
uploads/

